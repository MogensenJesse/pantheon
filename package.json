{
  "name": "pantheon",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc -p . && tsc -p tsconfig.scripts.json",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "village:kit": "node --experimental-strip-types scripts/village/village-kit-check.ts",
    "village:smoke": "node --experimental-strip-types scripts/village/sim-smoke.ts",
    "village:bench": "node --experimental-strip-types scripts/village/bench-wear.ts",
    "village:map": "node --experimental-strip-types scripts/village/layout-map.ts",
    "village:hamlet": "node --experimental-strip-types scripts/village/hamlet-check.ts",
    "village:economy": "node --experimental-strip-types scripts/village/economy-check.ts",
    "village:hunger": "node --experimental-strip-types scripts/village/hunger-check.ts",
    "village:forest": "node --experimental-strip-types scripts/village/forest-check.ts",
    "village:routine": "node --experimental-strip-types scripts/village/routine-check.ts",
    "village:check": "npm run village:kit && npm run village:smoke && npm run village:hamlet && npm run village:economy && npm run village:hunger && npm run village:forest && npm run village:routine",
    "ui:check": "node --experimental-strip-types scripts/ui/kit-check.ts",
    "abilities:check": "node --experimental-strip-types scripts/abilities/abilities-check.ts",
    "overview:check": "node --experimental-strip-types scripts/overview/overview-check.ts",
    "save:check": "node --experimental-strip-types scripts/save/save-check.ts",
    "quests:check": "node --experimental-strip-types scripts/quests/quests-check.ts",
    "powers:check": "node --experimental-strip-types scripts/abilities/powers-check.ts",
    "energy:check": "node --experimental-strip-types scripts/energy/energy-check.ts",
    "skills:check": "node --experimental-strip-types scripts/skills/skills-check.ts",
    "save:village": "node --experimental-strip-types scripts/save/village-save-check.ts",
    "lint:checked": "biome check src scripts/lib scripts/abilities scripts/energy scripts/overview scripts/quests scripts/save scripts/skills scripts/ui scripts/village",
    "check:fast": "npm run typecheck && npm run lint:checked && npm run ui:check && npm run skills:check && npm run abilities:check && npm run powers:check && npm run energy:check && npm run quests:check && npm run overview:check && npm run save:check && npm run village:kit && npm run village:hamlet && npm run village:economy && npm run village:hunger && npm run village:forest && npm run village:routine",
    "check:all": "npm run check:fast && npm run village:smoke && npm run save:village",
    "dead-code:report": "node scripts/gitnexus-dead-code-report.mjs",
    "sync-decoders": "node scripts/sync-decoders.mjs",
    "bake:night-exr": "node scripts/downscale-night-exr.mjs",
    "bake:grass-ktx2": "node scripts/bake-grass-ktx2.mjs",
    "bake:play-props": "node scripts/bake-play-props.mjs",
    "bake:terrain-atlases": "node --experimental-strip-types scripts/bake-terrain-atlases.mjs",
    "map:import-exr": "node --experimental-strip-types scripts/import-exr-map.ts"
  },
  "dependencies": {
    "alea": "^1.0.1",
    "fast-png": "^8.0.0",
    "fflate": "^0.8.3",
    "meshoptimizer": "^1.3.0",
    "stats-gl": "^4.2.3",
    "stats.js": "^0.17.0",
    "three": "^0.186.1",
    "three-mesh-bvh": "0.9.15",
    "watlas": "^1.0.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@gltf-transform/cli": "^4.5.0",
    "@types/node": "^26.6.3",
    "@types/stats.js": "^0.17.3",
    "@types/three": "^0.186.0",
    "hdrify": "^1.2.2",
    "sharp": "^0.35.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.1"
  }
}
