{
  "name": "pantheon",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc -p . && tsc -p tsconfig.scripts.json",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "check:fast": "npm run typecheck && npm run lint && node scripts/checks/run.mjs",
    "check:all": "npm run typecheck && npm run lint && node scripts/checks/run.mjs --slow",
    "check:abilities": "node scripts/checks/run.mjs abilities",
    "check:energy": "node scripts/checks/run.mjs energy",
    "check:landmarks": "node scripts/checks/run.mjs landmarks",
    "check:restoration": "node scripts/checks/run.mjs restoration",
    "check:map-entities": "node scripts/checks/run.mjs map-entities",
    "check:overview": "node scripts/checks/run.mjs overview",
    "check:powers": "node scripts/checks/run.mjs powers",
    "check:powers-builder": "node scripts/checks/run.mjs powers-builder",
    "check:quests": "node scripts/checks/run.mjs quests",
    "check:quest-content": "node scripts/checks/run.mjs quest-content",
    "check:save": "node scripts/checks/run.mjs save",
    "check:save-village": "node scripts/checks/run.mjs save-village",
    "check:skills": "node scripts/checks/run.mjs skills",
    "check:ui": "node scripts/checks/run.mjs ui",
    "check:village-economy": "node scripts/checks/run.mjs village-economy",
    "check:village-forest": "node scripts/checks/run.mjs village-forest",
    "check:village-golden": "node scripts/checks/run.mjs village-golden",
    "check:village-hamlet": "node scripts/checks/run.mjs village-hamlet",
    "check:village-hunger": "node scripts/checks/run.mjs village-hunger",
    "check:village-kit": "node scripts/checks/run.mjs village-kit",
    "check:village-routine": "node scripts/checks/run.mjs village-routine",
    "check:village-route": "node scripts/checks/run.mjs village-route",
    "check:village-remote": "node scripts/checks/run.mjs village-remote",
    "check:village-levels": "node scripts/checks/run.mjs village-levels",
    "check:village-plots": "node scripts/checks/run.mjs village-plots",
    "check:village-prayers": "node scripts/checks/run.mjs village-prayers",
    "check:village-hearten": "node scripts/checks/run.mjs village-hearten",
    "check:village-outposts": "node scripts/checks/run.mjs village-outposts",
    "check:village-smoke": "node scripts/checks/run.mjs village-smoke",
    "check:village-upgrades": "node scripts/checks/run.mjs village-upgrades",
    "check:weather": "node scripts/checks/run.mjs weather",
    "tool:village-map": "node --experimental-strip-types scripts/tools/village-map.ts",
    "tool:sync-decoders": "node scripts/tools/sync-decoders.mjs",
    "bake:night-exr": "node scripts/assets/downscale-night-exr.mjs",
    "bake:grass-ktx2": "node scripts/assets/bake-grass-ktx2.mjs",
    "bake:play-props": "node scripts/assets/bake-play-props.mjs",
    "bake:terrain-atlases": "node --experimental-strip-types scripts/assets/bake-terrain-atlases.mjs"
  },
  "dependencies": {
    "alea": "^1.0.1",
    "fast-png": "^8.0.0",
    "fflate": "^0.8.3",
    "meshoptimizer": "^1.3.0",
    "stats-gl": "^4.2.3",
    "stats.js": "^0.17.0",
    "three": "^0.186.1",
    "three-mesh-bvh": "0.9.15",
    "watlas": "^1.0.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@gltf-transform/cli": "^4.5.0",
    "@types/node": "^26.6.3",
    "@types/stats.js": "^0.17.3",
    "@types/three": "^0.186.0",
    "hdrify": "^1.2.2",
    "sharp": "^0.35.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.1"
  }
}
